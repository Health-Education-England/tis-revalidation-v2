{
  "name": "revalidation",
  "version": "1.11.2",
  "scripts": {
    "ng": "ng",
    "start": "npm run build:misc && ng serve",
    "start:mocky": "npm run start -- --configuration=mocky",
    "build": "node --max_old_space_size=4096 node_modules/@angular/cli/bin/ng build",
    "build:misc": "npm run build:browsers",
    "build:browsers": "node supported.browsers.node.ts",
    "test": "ng test --code-coverage=true",
    "test:ci": "npm run test -- --code-coverage=true --watch=false --browsers=ChromeHeadless",
    "lint": "ng lint",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "cypress": "cypress run --browser chrome",
    "cypress:local": "cypress run --browser electron --config baseUrl=http://localhost:4200",
    "cypress:alpha": "cypress run --browser chrome --config baseUrl=https://alpha-revalidation.tis.nhs.uk",
    "cypress:open": "cypress open --config baseUrl=http://localhost:4200",
    "tslint-check": "tslint-config-prettier-check ./tslint.json"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged && npm run lint"
    }
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.25",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.25",
    "@angular/compiler": "^19.2.25",
    "@angular/core": "^19.2.25",
    "@angular/forms": "^19.2.25",
    "@angular/material": "^19.2.19",
    "@angular/material-moment-adapter": "^19.2.19",
    "@angular/platform-browser": "^19.2.25",
    "@angular/platform-browser-dynamic": "^19.2.25",
    "@angular/router": "^19.2.25",
    "@angular/service-worker": "^19.2.25",
    "@ngxs/logger-plugin": "^19.0.0",
    "@ngxs/store": "^19.0.0",
    "@sentry/browser": "^9.47.1",
    "angular-eslint": "^19.8.1",
    "angular-google-tag-manager": "^1.11.0",
    "angulartics2": "^14.1.0",
    "aws-amplify": "^6.22.1",
    "browserslist": "^4.22.3",
    "cypress-otp": "^1.0.3",
    "dayjs": "^1.11.19",
    "file-saver": "^2.0.5",
    "karma-coverage": "^2.2.1",
    "moment": "^2.30.1",
    "nhsuk-frontend": "^7.1.0",
    "rxjs": "^7.4.0",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular-devkit/core": "^19.2.27",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.25",
    "@angular/language-service": "^19.2.25",
    "@ngxs/devtools-plugin": "^19.0.0",
    "@types/jasmine": "^4.6.4",
    "@types/node": "^18.19.15",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "browserslist-useragent-regexp": "^3.0.2",
    "cypress": "^15.1.0",
    "eslint": "^8.17.0",
    "husky": "^8.0.3",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "^6.4.1",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "karma-mocha-reporter": "^2.2.5",
    "ng-packagr": "^19.2.2",
    "prettier": "^3.8.3",
    "pretty-quick": "^3.1.3",
    "rollup": "^3.29.5",
    "stylelint": "^15.10.3",
    "stylelint-prettier": "^4.0.0",
    "ts-node": "~10.9.1",
    "tslint": "~6.1.3",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "^5.8.3"
  }
}
